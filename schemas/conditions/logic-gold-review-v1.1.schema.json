{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mle-team2:support-conditions:v1.1:logic-gold-review",
  "title": "Human review packet for logic gold data v1.1",
  "$defs": {
    "exception": {
      "type": "object",
      "required": [
        "raw_text",
        "evidence_reference",
        "applies_to_gold_ids",
        "linkage_status",
        "review_status",
        "review_comment",
        "effect",
        "effect_target",
        "replacement",
        "precondition",
        "effect_confirmed",
        "application_mode",
        "evidence_references"
      ],
      "properties": {
        "raw_text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_reference": {
          "type": "object",
          "required": [
            "start_char",
            "end_char"
          ],
          "properties": {
            "start_char": {
              "type": "integer",
              "minimum": 0
            },
            "end_char": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "applies_to_gold_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^GOLD:[A-Z2-7]{24}$"
          }
        },
        "linkage_status": {
          "type": "string",
          "enum": [
            "LINKED",
            "UNRESOLVED"
          ]
        },
        "review_status": {
          "type": "string",
          "enum": [
            "UNREVIEWED",
            "VERIFIED",
            "NEEDS_REVIEW",
            "REJECTED"
          ]
        },
        "review_comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect": {
          "type": "string",
          "enum": [
            "WAIVE_REQUIREMENT",
            "EXCLUDE_FROM_SCOPE",
            "REPLACE_DEADLINE",
            "UNKNOWN"
          ]
        },
        "effect_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "replacement": {
          "type": [
            "object",
            "null"
          ]
        },
        "precondition": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect_confirmed": {
          "type": "boolean"
        },
        "application_mode": {
          "type": "string",
          "enum": [
            "AST_ONLY",
            "EFFECT_ONLY",
            "UNKNOWN"
          ]
        },
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "source_field",
              "start_char",
              "end_char",
              "evidence_text",
              "document_id",
              "evidence_id"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "PRIMARY",
                  "SUPPORTING",
                  "CONTEXT"
                ]
              },
              "source_field": {
                "type": "string",
                "minLength": 1
              },
              "start_char": {
                "type": "integer",
                "minimum": 0
              },
              "end_char": {
                "type": "integer",
                "minimum": 1
              },
              "evidence_text": {
                "type": "string",
                "minLength": 1
              },
              "document_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "linkage_status": {
                "const": "LINKED"
              }
            },
            "required": [
              "linkage_status"
            ]
          },
          "then": {
            "properties": {
              "applies_to_gold_ids": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "benefit": {
      "type": "object",
      "required": [
        "benefit_type",
        "value",
        "unit",
        "raw_text",
        "evidence_reference",
        "applies_when_gold_ids",
        "review_status",
        "review_comment"
      ],
      "properties": {
        "benefit_type": {
          "type": "string",
          "enum": [
            "BONUS_POINTS",
            "PRIORITY_SELECTION",
            "FINANCIAL_BENEFIT",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_reference": {
          "type": "object",
          "required": [
            "start_char",
            "end_char"
          ],
          "properties": {
            "start_char": {
              "type": "integer",
              "minimum": 0
            },
            "end_char": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "applies_when_gold_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^GOLD:[A-Z2-7]{24}$"
          }
        },
        "review_status": {
          "type": "string",
          "enum": [
            "UNREVIEWED",
            "VERIFIED",
            "NEEDS_REVIEW",
            "REJECTED"
          ]
        },
        "review_comment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "unresolvedRelation": {
      "type": "object",
      "required": [
        "relation_id",
        "gold_condition_ids",
        "evidence_reference",
        "reason",
        "review_comment"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "gold_condition_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^GOLD:[A-Z2-7]{24}$"
          }
        },
        "evidence_reference": {
          "type": "object",
          "required": [
            "start_char",
            "end_char"
          ],
          "properties": {
            "start_char": {
              "type": "integer",
              "minimum": 0
            },
            "end_char": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "review_comment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "data_kind",
    "dataset_split",
    "notice_id",
    "source_system",
    "source_text",
    "condition_gold_ids",
    "gold_logic_roots",
    "gold_exceptions",
    "gold_benefits",
    "unresolved_relations",
    "review_status",
    "adjudication_status",
    "reviewer",
    "reviewed_at",
    "revision_history",
    "review_comment",
    "evaluation_version",
    "gold_logic_sections"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "record_type": {
      "const": "logic_gold_review"
    },
    "data_kind": {
      "const": "ACTUAL_SOURCE"
    },
    "dataset_split": {
      "type": "string",
      "enum": [
        "DEVELOPMENT",
        "EVALUATION"
      ]
    },
    "notice_id": {
      "type": "string",
      "minLength": 1
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "source_text": {
      "type": "string"
    },
    "condition_gold_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^GOLD:[A-Z2-7]{24}$"
      }
    },
    "gold_logic_roots": {
      "type": "array",
      "items": {
        "$ref": "urn:mle-team2:support-conditions:v1:common#/$defs/logicalExpression"
      }
    },
    "gold_exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "gold_benefits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/benefit"
      }
    },
    "unresolved_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedRelation"
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "UNREVIEWED",
        "VERIFIED",
        "NEEDS_REVIEW",
        "REJECTED"
      ]
    },
    "adjudication_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "REVIEWED_COMPLETE",
        "CONFIRMED_NONE_IN_PROVIDED_TEXT",
        "UNDECIDABLE",
        "EXCLUDED"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "review_comment": {
      "type": [
        "string",
        "null"
      ]
    },
    "existing_condition_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "existing_logic_roots": {
      "type": "object"
    },
    "existing_relation_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "existing_qualifier_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evaluation_version": {
      "const": "1.1"
    },
    "gold_logic_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "condition_type",
          "evaluation_phase",
          "fulfillment_phase",
          "root",
          "review_status"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "condition_type": {
            "type": "string",
            "enum": [
              "ELIGIBILITY",
              "EXCLUSION",
              "PREFERENCE",
              "POST_SELECTION_OBLIGATION"
            ]
          },
          "evaluation_phase": {
            "type": "string",
            "enum": [
              "APPLICATION",
              "SELECTION",
              "POST_SELECTION",
              "POST_MOVE_IN",
              "UNKNOWN"
            ]
          },
          "fulfillment_phase": {
            "type": "string",
            "enum": ["APPLICATION", "SELECTION", "POST_SELECTION", "POST_MOVE_IN", "UNKNOWN"]
          },
          "root": {
            "$ref": "urn:mle-team2:support-conditions:v1:common#/$defs/logicalExpression"
          },
          "review_status": {
            "enum": ["UNREVIEWED", "VERIFIED", "NEEDS_REVIEW", "REJECTED"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dataset_split": {
            "const": "DEVELOPMENT"
          }
        },
        "required": [
          "dataset_split"
        ]
      },
      "then": {
        "required": [
          "existing_condition_candidates",
          "existing_logic_roots",
          "existing_relation_candidates",
          "existing_qualifier_candidates"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "dataset_split": {
            "const": "EVALUATION"
          }
        },
        "required": [
          "dataset_split"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "existing_condition_candidates"
              ]
            },
            {
              "required": [
                "existing_logic_roots"
              ]
            },
            {
              "required": [
                "existing_relation_candidates"
              ]
            },
            {
              "required": [
                "existing_qualifier_candidates"
              ]
            }
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
