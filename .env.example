# .env 예시. 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다(.gitignore).

# Neo4j Aura
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Supabase (서비스 키는 서버에서만)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# LLM: OpenAI 호환 엔드포인트(vLLM 자리)
#   로컬 docker compose: LLM 게이트웨이(deploy/llm_gateway)가 vLLM 자리에서 외부 모델 gpt-6-luna를 부른다.
#     compose가 VLLM_BASE_URL=http://llm:8001/v1, VLLM_MODEL=gpt-6-luna를 넣는다. 게이트웨이 키는 OPEN_API(또는 OPENAI_API_KEY)
#   키 없이 대역 서버: VLLM_BASE_URL=http://localhost:8002/v1, VLLM_MODEL=mock-qwen (compose --profile mock)
#   RunPod vLLM:    VLLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1, VLLM_MODEL=<서빙 모델 이름>
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=
VLLM_TIMEOUT_S=60
# 대체 호스트(Plan B). 비워 두면 꺼짐
VLLM_ALT_BASE_URL=
VLLM_ALT_MODEL=
VLLM_ALT_API_KEY=
# 데이터 정책: self_hosted(기본, RunPod) | external(외부 모델). external이면 설명(answer) 역할은 아래 허용이 있어야만 쓴다
#   사용자 결정(2026-11-28, 로컬 시험 전용, 팀 검토 전): 게이트웨이(gpt-6-luna)를 쓸 때 external + 허용 1
VLLM_DATA_POLICY=
LLM_ALLOW_EXTERNAL_ANSWER=
# RAG 검색 임베딩(OpenAI 호환 /v1/embeddings). 비우면 VLLM_BASE_URL을 쓴다. 색인이 없거나 실패하면 BM25만 쓴다
EMBED_BASE_URL=
EMBED_MODEL=text-embedding-3-small
EMBED_API_KEY=
EMBED_DIM=512
RAG_INDEX_DIR=data/index

# 앱
APP_ENV=local
APP_CORS_ORIGINS=["http://localhost:3000"]
# 로컬 개발용 가짜 로그인(로그인 검증 A-01 구현 전). APP_ENV=local일 때만 켜진다. 배포에서는 비운다
APP_DEV_AUTH=
