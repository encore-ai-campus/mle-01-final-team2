# .env 예시. 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다(.gitignore).

# Neo4j Aura
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Supabase (서비스 키는 서버에서만)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# LLM: OpenAI 호환 엔드포인트(vLLM). 지금은 대역 서버(deploy/mock_vllm)
#   로컬 대역 서버: VLLM_BASE_URL=http://localhost:8001/v1, VLLM_MODEL=mock-qwen
#   RunPod vLLM:    VLLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1, VLLM_MODEL=<서빙 모델 이름>
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=
VLLM_TIMEOUT_S=60
# 대체 호스트(Plan B). 비워 두면 꺼짐
VLLM_ALT_BASE_URL=
VLLM_ALT_MODEL=
VLLM_ALT_API_KEY=

# 앱
APP_ENV=local
APP_CORS_ORIGINS=["http://localhost:3000"]
# 로컬 개발용 가짜 로그인(로그인 검증 A-01 구현 전). APP_ENV=local일 때만 켜진다. 배포에서는 비운다
APP_DEV_AUTH=
